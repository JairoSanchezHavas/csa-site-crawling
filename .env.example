# ==============================================================================
# CSA Tech Auditor · Havas - Environment Configuration Template
# Copia este archivo a .env para personalizar tu entorno local:
# cp .env.example .env
# ==============================================================================

# Entorno: development, staging, production
ENVIRONMENT=development
DEBUG=true

# Host y puerto de escucha
HOST=0.0.0.0
PORT=8080

# Orígenes CORS permitidos (separados por coma o * para desarrollo)
# Ejemplo para producción: https://mi-frontend.com,https://csa.havas.com
ALLOWED_ORIGINS=*

# Timeouts y límites de auditoría
DEFAULT_TIMEOUT_MS=20000
MAX_CRAWL_PAGES=15

# Modo de ejecución de Playwright (true en servidores, false si deseas ver la ventana de Chrome localmente al depurar)
PLAYWRIGHT_HEADLESS=true

# Directorio de archivos estáticos de la SPA
STATIC_DIR=static
